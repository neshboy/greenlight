{
  "name": "greenlight-scanner",
  "version": "0.1.0",
  "description": "Authorized-use vulnerability & reconnaissance scanner for penetration testers, with an enforced authorization gate and audit logging.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "greenlight": "dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
